-      !CBB_add_u16_length_prefixed(&contents, &sigalgs_cbb) ||
-      !tls12_add_verify_sigalgs(hs, &sigalgs_cbb) ||
+      !CBB_add_u16_length_prefixed(&contents, &sigalgs_cbb)) {
+    return false;
+  }
+  const SSL_CTX *ctx = hs->ssl->ctx.get();
+  if (ctx->mirage_grease_sigalgs &&
+      !CBB_add_u16(&sigalgs_cbb,
+                   ssl_get_grease_value(hs, ssl_grease_signature_algorithm))) {
+    return false;
+  }
+  if (!ctx->mirage_advertised_sigalgs.empty()) {
+    for (uint16_t sigalg : ctx->mirage_advertised_sigalgs) {
+      if (!CBB_add_u16(&sigalgs_cbb, sigalg)) {
+        return false;
+      }
+    }
+  } else if (!tls12_add_verify_sigalgs(hs, &sigalgs_cbb)) {
+    return false;
+  }
+  if (!CBB_flush(out_compressible)) {
+    return false;
+  }
+
+  return true;
+}
+
+// mirage: trust_anchors (draft-ietf-tls-trust-anchor-ids), sent verbatim.
+static bool ext_mirage_trust_anchors_add_clienthello(
+    const SSL_HANDSHAKE *hs, CBB *out, CBB *out_compressible,
+    ssl_client_hello_type_t type) {
+  const SSL_CTX *ctx = hs->ssl->ctx.get();
+  if (!ctx->mirage_trust_anchors_enabled || hs->max_version < TLS1_3_VERSION) {
+    return true;
+  }
+  CBB contents;
+  if (!CBB_add_u16(out_compressible, 0xca34) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
+      !CBB_add_bytes(&contents, ctx->mirage_trust_anchors.data(),
+                     ctx->mirage_trust_anchors.size()) ||
       !CBB_flush(out_compressible)) {
     return false;
   }
+  return true;
+}
 
